# --- Dossier de données généré (Contient config, db et logs) ---
data/

# Essais / scratch perso (ne pas commit)
dev_local/

# Companion (C33) — source + zips sideload commités ; builds décompressés locaux ignorés
companion/dist/_chrome/
companion/dist/_firefox/

# Configuration et secrets (TRÈS IMPORTANT)
config.json
docker-compose.yml

# Base de données locale
cache.db

# Logs et fichiers de debug
*.log
metakavita.log
nautiljon_dump.html
debug/build_wikidata_subset.py

# Mesures écrites par les scripts de mise en charge : des résultats de machine,
# refaits à chaque relance (les scripts, eux, sont suivis).
debug/stress/results/

# Environnements virtuels (si dev local hors docker)
venv/
.venv/
env/

# Fichiers systèmes ou générés par Python
__pycache__/
*.pyc
*.pyo

# IDE et Éditeurs (VSCode, PyCharm, etc.)
.vscode/
.idea/

# Fichiers macOS / Windows (toujours utile)
.DS_Store
Thumbs.db

# Batteries live (artefacts)
tests/_manganews_*
tests/_fandom_*
