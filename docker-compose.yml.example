services:
  metakavita:
    image: ghcr.io/raukorim-bot/metakavita:latest
    container_name: metakavita
    restart: unless-stopped
    ports:
      - "5010:5010"
    # Permet d'atteindre Kavita (ou tout service) publié sur l'hôte via
    # http://host.docker.internal:<port_hôte> — indispensable si Kavita n'est
    # PAS sur le même réseau Docker Compose que MetaKavita (cas Portainer /
    # stacks séparés). Sous Linux, host-gateway est requis.
    #
    # Reach Kavita (or any service) published on the host via
    # http://host.docker.internal:<host_port> — required when Kavita is NOT on
    # the same Docker Compose network as MetaKavita (Portainer / separate
    # stacks). On Linux, host-gateway is required.
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      # --- Permissions du dossier data / data folder ownership ---
      # Le conteneur tourne en utilisateur non-root (1000:1000 par défaut).
      # Si votre dossier ./data appartient à un autre utilisateur, renseignez
      # votre UID/GID (`id -u` / `id -g`) — sinon, laissez commenté.
      #
      # The container runs as a non-root user (1000:1000 by default). If your
      # ./data folder is owned by a different user, set your own UID/GID here
      # (`id -u` / `id -g`) — otherwise leave commented out.
      # - PUID=1000
      # - PGID=1000

      # --- Authentification / Authentication ---
      # Au premier démarrage, MetaKavita ouvre un écran de configuration qui vous
      # fait créer votre compte. Rien à renseigner ici pour un usage normal.
      #
      # On first run, MetaKavita opens a setup screen where you create your
      # account. Nothing to set here for a normal install.
      #
      # Reverse proxy : laissez 1 si MetaKavita est derrière nginx/Traefik/Caddy.
      # METTEZ 0 si vous y accédez directement — sinon l'en-tête X-Forwarded-For
      # est fourni par le client et le verrouillage par IP peut être esquivé en
      # le faisant varier. Un plafond global (20 échecs par quart d'heure) borne
      # la force brute dans tous les cas, mais il verrouille alors l'écran de
      # connexion pour tout le monde.
      #
      # Reverse proxy: leave at 1 if MetaKavita sits behind nginx/Traefik/Caddy.
      # SET IT TO 0 if you reach it directly — otherwise X-Forwarded-For is
      # supplied by the client and the per-IP lockout can be evaded by rotating
      # it. A global cap (20 failures per 15 minutes) bounds brute-force in every
      # case, but it locks the login screen for everyone when it trips.
      - TRUSTED_PROXY_COUNT=0
      #
      # Déploiement pré-provisionné : générez un hachage avec
      # `python debug/hash_password.py` pour sauter l'écran de configuration.
      # Ignoré si un compte existe déjà.
      #
      # Pre-provisioned deploy: generate a hash with
      # `python debug/hash_password.py` to skip the setup screen.
      # Ignored once an account exists.
      # - ADMIN_USERNAME=admin
      # - ADMIN_PASSWORD_HASH=pbkdf2:sha256:...

      # --- Kavita (recommandé dès le 1er lancement / recommended on first run) ---
      # JAMAIS localhost / 127.0.0.1 depuis le conteneur (= MetaKavita lui-même).
      # NEVER localhost / 127.0.0.1 from inside the container (= MetaKavita itself).
      #
      # Kavita publié sur l'hôte (ex. Portainer, port 5001→5000) :
      # Kavita published on the host (e.g. Portainer, 5001→5000):
      # - KAVITA_URL=http://host.docker.internal:5001
      #
      # Kavita sur le même réseau Docker (service nommé "kavita") :
      # Kavita on the same Docker network (service name "kavita"):
      # - KAVITA_URL=http://kavita:5000
      #
      # Kavita distant (prod) : URL publique HTTPS + clé API.
      # Remote Kavita (prod): public HTTPS URL + API key.
      # - KAVITA_URL=https://kavita.example.com
      # - KAVITA_API_KEY=ta_cle_api_kavita
      # - KAVITA_EXTERNAL_URL=https://kavita.example.com

      # --- Variables Optionnelles / Optional Variables ---
      # Toutes ces valeurs peuvent aussi être configurées depuis l'interface Web.
      # All these values can also be configured later from the Web UI.

      # - DEEPL_API_KEY=ta_cle_api_deepl
      # - TARGET_LANG=FR
      # Fresh install tip: set English UI before first open (default is French).
      # Install neuve : forcer l'anglais avant la 1ère ouverture (défaut = français).
      # - UI_LANG=en
      # - PROVIDER_1=MANGABAKA
      # - PROVIDER_2=KITSU
      # - PROVIDER_3=ANILIST
      # - SMART_COMPLETION=false
      # - AUTO_SYNC_INTERVAL=0
      # - AUTO_COVER=false
      
    volumes:
      # Le dossier 'data' contiendra le config.json, la base de données cache.db et les logs.
      - ./data:/app/data
